# gitignore for Visual Studio and .NET projects

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
.vscode/

# NuGet Packages
*.nupkg
packages/

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Crystal Reports - Generated/Compiled files
# We ignore generated code, but keep the raw .rpt files.
*.rpt
# Note: Usually you want to keep .rpt in version control as they are the source definitions, 
# but per instructions, ignoring .rpt files here to avoid large binary commits of reports.

# Temporary files
*.tmp
*.bak
*.swp
*~.nib

# MacOS/Windows junk
.DS_Store
Thumbs.db
