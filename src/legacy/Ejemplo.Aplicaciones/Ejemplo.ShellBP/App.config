<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="BankLabDB" connectionString="Server=localhost;Database=BankLabDB;User Id=sa;Password=BankLab2024!;TrustServerCertificate=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="WCF_Endpoint_Clientes" value="net.tcp://localhost:8808/BancoEjemplo/Clientes" />
    <add key="WCF_Endpoint_Cuentas" value="net.tcp://localhost:8808/BancoEjemplo/Cuentas" />
    <add key="WCF_Endpoint_Creditos" value="net.tcp://localhost:8808/BancoEjemplo/Creditos" />
    <add key="WCF_Endpoint_Pagos" value="net.tcp://localhost:8808/BancoEjemplo/Pagos" />
    <add key="WCF_Endpoint_Cartera" value="net.tcp://localhost:8808/BancoEjemplo/Cartera" />
    <add key="TimeoutSegundos" value="30" />
    <add key="NivelLog" value="Info" />
  </appSettings>
  <startup>
