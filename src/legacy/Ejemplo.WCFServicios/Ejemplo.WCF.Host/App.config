<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="BankLabDB"
         connectionString="Server=localhost;Database=BankLabDB;User Id=sa;Password=BankLab2024!;TrustServerCertificate=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="TimeoutSegundos" value="30" />
    <add key="NivelLog" value="Info" />
  </appSettings>
  <system.serviceModel>
    <services>
      <service name="Ejemplo.WCF.Servicios.ClientesServicio" behaviorConfiguration="defaultBehavior">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="defaultNetTcp"
                  contract="Ejemplo.WCF.Contratos.IClientesServicio" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8808/BancoEjemplo/Clientes" />
          </baseAddresses>
        </host>
      </service>
      <service name="Ejemplo.WCF.Servicios.CuentasServicio" behaviorConfiguration="defaultBehavior">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="defaultNetTcp"
                  contract="Ejemplo.WCF.Contratos.ICuentasServicio" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8808/BancoEjemplo/Cuentas" />
          </baseAddresses>
        </host>
      </service>
      <service name="Ejemplo.WCF.Servicios.CreditosServicio" behaviorConfiguration="defaultBehavior">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="defaultNetTcp"
                  contract="Ejemplo.WCF.Contratos.ICreditosServicio" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8808/BancoEjemplo/Creditos" />
          </baseAddresses>
        </host>
      </service>
      <service name="Ejemplo.WCF.Servicios.PagosServicio" behaviorConfiguration="defaultBehavior">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="defaultNetTcp"
                  contract="Ejemplo.WCF.Contratos.IPagosServicio" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8808/BancoEjemplo/Pagos" />
          </baseAddresses>
        </host>
      </service>
      <service name="Ejemplo.WCF.Servicios.CarteraServicio" behaviorConfiguration="defaultBehavior">
        <endpoint address="" binding="netTcpBinding" bindingConfiguration="defaultNetTcp"
                  contract="Ejemplo.WCF.Contratos.ICarteraServicio" />
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:8808/BancoEjemplo/Cartera" />
          </baseAddresses>
        </host>
      </service>
    </services>
    <bindings>
      <netTcpBinding>
        <binding name="defaultNetTcp"
                 maxReceivedMessageSize="2147483647"
                 maxBufferSize="2147483647"
                 openTimeout="00:01:00"
                 closeTimeout="00:01:00"
                 sendTimeout="00:05:00"
                 receiveTimeout="00:10:00">
          <security mode="None" />
          <readerQuotas maxDepth="32"
                        maxStringContentLength="2147483647"
                        maxArrayLength="2147483647"
                        maxBytesPerRead="4096"
                        maxNameTableCharCount="16384" />
        </binding>
      </netTcpBinding>
    </bindings>
    <behaviors>
      <serviceBehaviors>
        <behavior name="defaultBehavior">
          <serviceMetadata />
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceThrottling maxConcurrentCalls="100"
                             maxConcurrentSessions="100"
                             maxConcurrentInstances="100" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
