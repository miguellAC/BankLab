<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Endpoint del host WCF de la rebanada (CuentasAgente lo lee de aqui) -->
    <add key="WCF_Endpoint_Cuentas" value="net.tcp://localhost:8808/BancoEjemplo/Cuentas" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
