<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Cadena de conexión principal (completar Password antes de desplegar) -->
    <add key="ConnectionString" value="Server=localhost,1433;Database=BankLabDB;User Id=sa;Password=COMPLETAR;TrustServerCertificate=True;" />
  </appSettings>

  <system.serviceModel>
    <services>
      <service name="Ejemplo.WCF.Servicios.CuentasServicio"
               behaviorConfiguration="CuentasServicioBehavior">
        <endpoint address=""
                  binding="netTcpBinding"
                  bindingConfiguration="netTcpBindingConfig"
                  contract="Ejemplo.WCF.Contratos.ICuentasServicio" />
        <endpoint address="mex"
                  binding="mexTcpBinding"
                  contract="IMetadataExchange" />
      </service>
    </services>

    <bindings>
      <netTcpBinding>
        <binding name="netTcpBindingConfig"
                 maxBufferSize="2147483647"
                 maxReceivedMessageSize="2147483647"
                 receiveTimeout="00:10:00"
                 sendTimeout="00:10:00"
                 openTimeout="00:01:00"
                 closeTimeout="00:01:00">
          <readerQuotas maxDepth="64"
                        maxStringContentLength="2147483647"
                        maxArrayLength="2147483647"
                        maxBytesPerRead="2147483647"
                        maxNameTableCharCount="2147483647" />
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>

    <behaviors>
      <serviceBehaviors>
        <behavior name="CuentasServicioBehavior">
          <serviceMetadata />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <!-- Activación WAS para net.tcp -->
    <serviceHostingEnvironment multipleSiteBindingsEnabled="true" />
  </system.serviceModel>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
