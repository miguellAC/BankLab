<Project>
  <!--
    REBANADA "SALDO" (laboratorio) - NO afecta a las soluciones normales.
    Solo se activa cuando se pasa explicitamente  /p:SliceSaldo=true  (o la variable de entorno SliceSaldo=true,
    que es lo que hace tools/build-saldo.ps1 y tools/abrir-saldo-vs.ps1).
    Sin esa propiedad este archivo no cambia nada.

    Que hace: quita de la compilacion los archivos de los modulos ajenos a Cuentas (Clientes, Creditos, Pagos,
    Cartera, Importacion, Auditoria) en los proyectos compartidos. Los archivos NO se borran ni se modifican;
    los errores de esos modulos siguen existiendo en la compilacion normal (ver docs/fase1-errores-compilacion-completa.md).
    Para reincorporar un modulo: borrar sus lineas Compile Remove de este archivo.
  -->
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.Componentes.DAT'">
    <Compile Remove="ClientesDAT.cs" />
    <SliceSaldoExcluido Include="ClientesDAT.cs" />
    <Compile Remove="CreditosDAT.cs" />
    <SliceSaldoExcluido Include="CreditosDAT.cs" />
    <Compile Remove="PagosDAT.cs" />
    <SliceSaldoExcluido Include="PagosDAT.cs" />
    <Compile Remove="CarteraDAT.cs" />
    <SliceSaldoExcluido Include="CarteraDAT.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.Componentes.DAL'">
    <Compile Remove="ClientesDAL.cs" />
    <SliceSaldoExcluido Include="ClientesDAL.cs" />
    <Compile Remove="CreditosDAL.cs" />
    <SliceSaldoExcluido Include="CreditosDAL.cs" />
    <Compile Remove="PagosDAL.cs" />
    <SliceSaldoExcluido Include="PagosDAL.cs" />
    <Compile Remove="CarteraDAL.cs" />
    <SliceSaldoExcluido Include="CarteraDAL.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.Componentes.DAS'">
    <Compile Remove="ClientesDAS.cs" />
    <SliceSaldoExcluido Include="ClientesDAS.cs" />
    <Compile Remove="CreditosDAS.cs" />
    <SliceSaldoExcluido Include="CreditosDAS.cs" />
    <Compile Remove="PagosDAS.cs" />
    <SliceSaldoExcluido Include="PagosDAS.cs" />
    <Compile Remove="CarteraDAS.cs" />
    <SliceSaldoExcluido Include="CarteraDAS.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.Componentes.BLL'">
    <Compile Remove="ClientesBLL.cs" />
    <SliceSaldoExcluido Include="ClientesBLL.cs" />
    <Compile Remove="CreditosBLL.cs" />
    <SliceSaldoExcluido Include="CreditosBLL.cs" />
    <Compile Remove="PagosBLL.cs" />
    <SliceSaldoExcluido Include="PagosBLL.cs" />
    <Compile Remove="CarteraBLL.cs" />
    <SliceSaldoExcluido Include="CarteraBLL.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.WCF.Contratos'">
    <Compile Remove="IClientesServicio.cs" />
    <SliceSaldoExcluido Include="IClientesServicio.cs" />
    <Compile Remove="ICreditosServicio.cs" />
    <SliceSaldoExcluido Include="ICreditosServicio.cs" />
    <Compile Remove="IPagosServicio.cs" />
    <SliceSaldoExcluido Include="IPagosServicio.cs" />
    <Compile Remove="ICarteraServicio.cs" />
    <SliceSaldoExcluido Include="ICarteraServicio.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.WCF.Servicios'">
    <Compile Remove="ClientesServicio.cs" />
    <SliceSaldoExcluido Include="ClientesServicio.cs" />
    <Compile Remove="CreditosServicio.cs" />
    <SliceSaldoExcluido Include="CreditosServicio.cs" />
    <Compile Remove="PagosServicio.cs" />
    <SliceSaldoExcluido Include="PagosServicio.cs" />
    <Compile Remove="CarteraServicio.cs" />
    <SliceSaldoExcluido Include="CarteraServicio.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SliceSaldo)' == 'true' and '$(MSBuildProjectName)' == 'Ejemplo.WCF.Agentes'">
    <Compile Remove="ClientesAgente.cs" />
    <SliceSaldoExcluido Include="ClientesAgente.cs" />
    <Compile Remove="CreditosAgente.cs" />
    <SliceSaldoExcluido Include="CreditosAgente.cs" />
    <Compile Remove="PagosAgente.cs" />
    <SliceSaldoExcluido Include="PagosAgente.cs" />
    <Compile Remove="CarteraAgente.cs" />
    <SliceSaldoExcluido Include="CarteraAgente.cs" />
  </ItemGroup>
  <Target Name="InformeRebanadaSaldo" BeforeTargets="CoreCompile" Condition="'$(SliceSaldo)' == 'true' and '@(SliceSaldoExcluido)' != ''">
    <Message Importance="high" Text="[REBANADA SALDO ACTIVA] $(MSBuildProjectName): @(SliceSaldoExcluido->Count()) archivo(s) excluido(s): @(SliceSaldoExcluido, ', ')" />
  </Target>
</Project>
